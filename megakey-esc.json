{
    "title": "MegaKey (tap → Esc)",
    "rules": [
        {
            "description": "Caps Lock → Mega (⌃⌥⌘), tap → Esc",
            "manipulators": [
                {
                    "from": {
                        "key_code": "caps_lock",
                        "modifiers": { "mandatory": ["fn"], "optional": ["any"] }
                    },
                    "to": [{ "key_code": "caps_lock" }],
                    "type": "basic"
                },
                {
                    "from": {
                        "key_code": "caps_lock",
                        "modifiers": { "optional": ["any"] }
                    },
                    "to": [{
                        "key_code": "left_command",
                        "modifiers": ["left_control", "left_option"]
                    }],
                    "to_if_alone": [{ "key_code": "escape" }],
                    "type": "basic"
                }
            ]
        },
        {
            "description": "Tab → Giga (⇧⌃⌥⌘), tap → Tab",
            "manipulators": [
                {
                    "from": {
                        "key_code": "tab",
                        "modifiers": { "optional": ["any"] }
                    },
                    "to": [{
                        "key_code": "left_shift",
                        "modifiers": ["left_control", "left_option", "left_command"]
                    }],
                    "to_if_alone": [{ "key_code": "tab" }],
                    "type": "basic"
                }
            ]
        },
        {
            "description": "Right Ctrl -> Chaos (Option+Command)",
            "manipulators": [
                {
                    "from": {
                        "key_code": "right_control",
                        "modifiers": { "optional": ["any"] }
                    },
                    "to": [{
                        "key_code": "left_option",
                        "modifiers": ["left_command"]
                    }],
                    "type": "basic"
                }
            ]
        },
        {
            "description": "Right Option → Force (⌃⌘)",
            "manipulators": [
                {
                    "from": {
                        "key_code": "right_option",
                        "modifiers": { "optional": ["any"] }
                    },
                    "to": [{
                        "key_code": "left_control",
                        "modifiers": ["left_command"]
                    }],
                    "type": "basic"
                }
            ]
        },
        {
            "description": "Right Cmd -> Wish (Ctrl+Option)",
            "manipulators": [
                {
                    "from": {
                        "key_code": "right_command",
                        "modifiers": { "optional": ["any"] }
                    },
                    "to": [{
                        "key_code": "left_control",
                        "modifiers": ["left_option"]
                    }],
                    "type": "basic"
                }
            ]
        },
        {
            "description": "Optional clipboard demo: Mega+C/V -> Cmd+C/V (Shift passes through)",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "c",
                        "modifiers": {
                            "mandatory": [
                                "control",
                                "option",
                                "command"
                            ],
                            "optional": [
                                "shift"
                            ]
                        }
                    },
                    "to": [
                        {
                            "key_code": "c",
                            "modifiers": [
                                "left_command"
                            ]
                        }
                    ]
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "v",
                        "modifiers": {
                            "mandatory": [
                                "control",
                                "option",
                                "command"
                            ],
                            "optional": [
                                "shift"
                            ]
                        }
                    },
                    "to": [
                        {
                            "key_code": "v",
                            "modifiers": [
                                "left_command"
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
